@model CRUDEAppUsignADO.Models.Employees

@{
    ViewData["Title"] = "Delete Employee";
}

<style>
    body {
        background: linear-gradient(135deg,#4a6cf7,#ff4fa0);
    }

    .delete-card {
        max-width: 700px;
        margin: 60px auto;
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,.15);
    }

    .delete-header {
        background: linear-gradient(90deg,#ff4fa0,#3563ff);
        color: white;
        padding: 20px;
        text-align: center;
    }

    .info-box {
        background: #f8f9fa;
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 10px;
    }

    .label-text {
        font-weight: 600;
        color: #555;
    }

    .value-text {
        font-size: 16px;
        color: #222;
    }

    .btn-delete {
        background: #dc3545;
        border: none;
        padding: 10px 25px;
        border-radius: 10px;
    }

    .btn-back {
        background: #6c757d;
        color: white;
        border-radius: 10px;
        padding: 10px 25px;
        text-decoration: none;
    }
</style>

<div class="container">

    <div class="card delete-card">

        <div class="delete-header">
            <h2>⚠ Delete Employee</h2>
            <p class="mb-0">
                Are you sure you want to delete this employee?
            </p>
        </div>

        <div class="card-body p-4">

            <div class="alert alert-warning text-center">
                This action cannot be undone!
            </div>

            <div class="info-box">
                <span class="label-text">Name :</span>
                <span class="value-text">@Model.Name</span>
            </div>

            <div class="info-box">
                <span class="label-text">Gender :</span>
                <span class="value-text">@Model.Gender</span>
            </div>

            <div class="info-box">
                <span class="label-text">Age :</span>
                <span class="value-text">@Model.Age</span>
            </div>

            <div class="info-box">
                <span class="label-text">Designation :</span>
                <span class="value-text">@Model.Designation</span>
            </div>

            <div class="info-box">
                <span class="label-text">City :</span>
                <span class="value-text">@Model.City</span>
            </div>

            <form asp-action="Delete" class="mt-4 text-center">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-delete text-black me-2">
                    🗑 Confirm Delete
                </button>

                <a asp-action="Index" class="btn-back">
                    ← Back
                </a>

            </form>

        </div>

    </div>

</div>

