@model CRUDEAppUsignADO.Models.Employees

@{
    ViewData["Title"] = "Employee Details";
}

<style>
    body {
        background: linear-gradient(135deg,#4a6cf7,#ff4fa0);
        min-height: 100vh;
    }

    .details-card {
        max-width: 800px;
        margin: 40px auto;
        border: none;
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 35px rgba(0,0,0,.15);
    }

    .details-header {
        background: linear-gradient(90deg,#ff4fa0,#3563ff);
        color: white;
        text-align: center;
        padding: 25px;
    }

    .info-box {
        background: #f8f9fa;
        border-left: 5px solid #3563ff;
        border-radius: 10px;
        padding: 15px;
        margin-bottom: 15px;
    }

    .label-text {
        font-weight: 700;
        color: #555;
    }

    .value-text {
        font-size: 18px;
        color: #222;
    }

    .btn-edit {
        background: linear-gradient(90deg,#ff4fa0,#3563ff);
        border: none;
        color: white;
        padding: 10px 25px;
        border-radius: 10px;
    }

        .btn-edit:hover {
            color: white;
        }

    .btn-back {
        padding: 10px 25px;
        border-radius: 10px;
    }
</style>

<div class="container">

    <div class="card details-card">

        <div class="details-header">
            <h2>👨‍💼 Employee Details</h2>
            <p class="mb-0">Employee Information Overview</p>
        </div>

        <div class="card-body p-4">

            <div class="text-center mb-4">
                <img src="https://cdn-icons-png.flaticon.com/512/3135/3135715.png"
                     width="100"
                     class="rounded-circle border p-2" />
            </div>

            <div class="info-box">
                <div class="label-text">Name</div>
                <div class="value-text">@Model.Name</div>
            </div>

            <div class="info-box">
                <div class="label-text">Gender</div>
                <div class="value-text">@Model.Gender</div>
            </div>

            <div class="info-box">
                <div class="label-text">Age</div>
                <div class="value-text">@Model.Age</div>
            </div>

            <div class="info-box">
                <div class="label-text">Designation</div>
                <div class="value-text">@Model.Designation</div>
            </div>

            <div class="info-box">
                <div class="label-text">City</div>
                <div class="value-text">@Model.City</div>
            </div>

            <div class="text-center mt-4">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-edit me-2">
                    ✏ Edit
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary btn-back">
                    ← Back
                </a>

            </div>

        </div>

    </div>

</div>
