@model IEnumerable<CRUDEAppUsignADO.Models.Employees>

@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

<style>
    body {
        background: linear-gradient(135deg,#4a6cf7,#ff4fa0);
        min-height: 100vh;
        font-family: 'Segoe UI', sans-serif;
    }

    .dashboard-card {
        border: none;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,.1);
        transition: .3s;
    }

    .dashboard-card:hover {
        transform: translateY(-5px);
    }

    .icon-box {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 25px;
    }

    .pink {
        background: linear-gradient(45deg,#ff4fa0,#ff6a88);
    }

    .blue {
        background: linear-gradient(45deg,#3563ff,#5b8cff);
    }

    .main-card {
        background: #fff;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
    }

    .table-header {
        background: linear-gradient(90deg,#ff4fa0,#3563ff);
        color: white;
    }

    .btn-gradient {
        background: linear-gradient(90deg,#ff4fa0,#3563ff);
        color: white;
        border: none;
    }

    .btn-gradient:hover {
        color: white;
    }

    .gender-badge {
        background: #e8f0ff;
        color: #3563ff;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 13px;
    }
</style>



<div class="col-12 text-center">

    <h1 class="fw-bold display-5">
        Welcome to Employee Management System
    </h1>
</div>  

<div class="container-fluid py-4">

    <div class="main-card">
        <div class="row">
            
        </div>

        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="fw-bold">Dashboard</h1>
            @*     <p class="text-muted">
                    Welcome to Employee Management System
                </p> *@
            </div>

            <a asp-action="Create" class="btn btn-gradient px-4 py-2">
                <i class="fa-solid fa-circle-plus"></i>
                Add Employee
            </a>
        </div>

        <!-- Dashboard Cards -->
        <div class="row g-4 mb-5">

            <div class="col-md-3">
                <div class="card dashboard-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="icon-box pink me-3">
                            <i class="fa-solid fa-users"></i>
                        </div>

                        <div>
                            <h6>Total Employees</h6>
                            <h2>@Model.Count()</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card dashboard-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="icon-box blue me-3">
                            <i class="fa-solid fa-mars"></i>
                        </div>

                        <div>
                            <h6>Male Employees</h6>
                            <h2>@Model.Count(x => x.Gender == "male")</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card dashboard-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="icon-box pink me-3">
                            <i class="fa-solid fa-venus"></i>
                        </div>

                        <div>
                            <h6>Female Employees</h6>
                            <h2>@Model.Count(x => x.Gender == "female")</h2>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="card dashboard-card">
                    <div class="card-body d-flex align-items-center">
                        <div class="icon-box blue me-3">
                            <i class="fa-solid fa-building"></i>
                        </div>

                        <div>
                            <h6>Departments</h6>
                            <h2>@Model.Select(x => x.Designation).Distinct().Count()</h2>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- Employee List -->
        <div class="card border-0 shadow-sm">

            <div class="card-body">

                <h3 class="fw-bold mb-4">
                    <span style="color:#ff4fa0">Employees</span>
                    <span style="color:#3563ff">List</span>
                </h3>

                <table class="table align-middle">

                    <thead class="table-header">
                        <tr>
                            <th>Id</th>
                            <th>Name</th>
                            <th>Gender</th>
                            <th>Age</th>
                            <th>Designation</th>
                            <th>City</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int sr = 1;
                        }

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>@sr</td>

                                <td>@item.Name</td>

                                <td>
                                    <span class="gender-badge">
                                        @item.Gender
                                    </span>
                                </td>

                                <td>@item.Age</td>

                                <td>@item.Designation</td>

                                <td>@item.City</td>

                                <td>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-primary btn-sm">
                                        <i class="fa-solid fa-eye"></i>
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-info btn-sm">
                                        <i class="fa-solid fa-pen"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-danger btn-sm">
                                        <i class="fa-solid fa-trash"></i>
                                    </a>

                                </td>

                            </tr>

                            sr++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>
